{
    "name": "LMblog",
    "title": "Lotus Moon's Blog",
    "author": "Lotus Moon <lotus_0_moon@sina.com>",
    "version": "2.0.0",
    "homepage": "http://lotus0moon.github.io",
    "repository": {
        "type": "git",
        "url": "https://github.com/lotus_0_moon/lotus0moon.github.io"
    },
    "bugs": "https://github.com/lotus_0_moon/lotus0moon.github.io/issues", 
    "scripts": {
        "start": "bundle exec jekyll serve",
        "build": "node build.js",
        "watch:assets": "chokidar \"less/**/*.less\" \"js/**/*.js\" -c \"npm run build\" --initial",
        "dev": "concurrently \"npm run watch:assets\" \"npm run start\"",
        "push": "git push origin master --tag",
        "boil": "git push boilerplate boilerplate:master"
    },
    "devDependencies": {
        "less": "^4.2.0",
        "less-plugin-clean-css": "^1.5.1",
        "uglify-js": "^3.17.4",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.1.2"
    }
}
